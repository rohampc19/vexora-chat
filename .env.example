# ============================================
# VEXORA CHAT v4.0 - Production Environment
# ============================================

# ========== SERVER ==========
NODE_ENV=production
PORT=3000

# ========== DATABASE ==========
DATABASE_URL="postgresql://vexora_admin:CHANGE_ME@postgres:5432/vexora_chat"
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ========== REDIS ==========
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DB=0

# ========== REDIS (اختیاری، برای cache/session support) ==========
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0
# ========== JWT & SECURITY ==========
# تولید با: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_MIN_64_CHARS_RANDOM_STRING

# ========== CORS ==========
ALLOWED_ORIGINS=https://vexora-chat.ir,https://www.vexora-chat.ir

# ========== FILE UPLOAD ==========
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ========== LOGGING ==========
LOG_LEVEL=info

# ========== VPS DEPLOYMENT (GitHub Secrets) ==========
# اینا رو در GitHub Repository Settings > Secrets اضافه کن:
# VPS_HOST=your.vps.ip.address
# VPS_USERNAME=root
# VPS_SSH_KEY=your_private_ssh_key
